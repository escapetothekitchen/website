---
const { title = 'Escape to the Kitchen' } = Astro.props;
import "../styles/global.css";
---
<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-full text-slate-900">
    <div class="site-shell min-h-full">
      <header class="site-header sticky top-0 z-10 border-b backdrop-blur">
        <div class="container flex items-center justify-end py-3">
          <nav aria-label="Main navigation" class="flex items-center gap-4 text-sm">
            <a class="link" href="/">Home</a>
            <a class="link" href="/categories">Categories</a>
            <a class="link" href="/recipes">All Recipes</a>
            <a class="link" href="/about/">About</a>
          </nav>
        </div>
      </header>

      <main class="py-8">
        <div class="container">
          <slot />
        </div>
      </main>

      <footer class="site-footer border-t">
        <div class="container flex items-center justify-between py-6 text-sm text-muted">
          <span>© {new Date().getFullYear()} Escape to the Kitchen</span>
        </div>
      </footer>
    </div>
  </body>
</html>
