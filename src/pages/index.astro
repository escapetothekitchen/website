---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';
import { recipeImage } from '../lib/recipeImage';
import { formatPublicationDate } from '../lib/date';
const recipes = await getCollection('recipes');
const sorted = recipes.sort((a,b) => (new Date(b.data.date).getTime() - new Date(a.data.date).getTime()));
---
<BaseLayout title="Escape to the Kitchen">
  <section class="container mb-8" aria-labelledby="site-title">
    <div class="site-brand">
      <img src="/favicon.png" alt="" width="96" height="95" class="site-logo" />
      <h1 id="site-title" class="site-title">Escape to the Kitchen</h1>
    </div>
    <nav aria-label="Browse recipes" class="browse-links">
      <a href="/categories/" class="font-semibold">Browse by Categories</a>
      <a href="/categories/dessert/">Desserts</a>
      <a href="/categories/main/">Main Dishes</a>
      <a href="/categories/appetizer/">Appetizers</a>
      <a href="/recipes/">All Recipes</a>
    </nav>
  </section>
  <section class="container grid gap-2 pb-2">
    <p class="text-muted max-w-prose text-[13px]">Family recipes, easy to browse and search.</p>
    <div class="flex w-full max-w-md items-center gap-2 rounded-lg border border-[#e5dccf] bg-white/60 px-3 py-1.5 focus-within:ring-2 focus-within:ring-brand-300">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0 text-slate-400" aria-hidden="true"><path fill-rule="evenodd" d="M10.5 3.75a6.75 6.75 0 105.364 11.108l3.889 3.889a.75.75 0 101.06-1.06l-3.888-3.89A6.75 6.75 0 0010.5 3.75zm-5.25 6.75a5.25 5.25 0 1110.5 0 5.25 5.25 0 01-10.5 0z" clip-rule="evenodd"/></svg>
      <input id="home-search" type="search" aria-label="Search recipes" placeholder="Search recipes (name, ingredients, notes)" autocomplete="off" class="min-w-0 w-full border-0 bg-transparent py-1 text-sm outline-none" />
    </div>
  </section>

  <section class="container mt-6">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-xl font-semibold">Latest</h2>
      <a href="/recipes" class="view-all-link">View all →</a>
    </div>
    <div id="latest" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {sorted.slice(0, 12).map(({ slug, data, body }) => (
        <div class="card p-4">
          <div class="flex items-start gap-4">
          {recipeImage(body, data.image) && (
            <a href={`/recipes/${slug}`} aria-hidden="true" tabindex="-1" class="shrink-0">
              <img src={recipeImage(body, data.image)} alt="" width="80" height="80" loading="lazy" decoding="async" class="h-20 w-20 rounded-lg object-cover" />
            </a>
          )}
          <div class="grid min-w-0 flex-1 gap-2">
            <a href={`/recipes/${slug}`} class="font-semibold tracking-tight text-slate-900 hover:underline">{data.title}</a>
            <div class="publication-date">{formatPublicationDate(data.date)}</div>
            <div class="flex flex-wrap gap-1">
              {data.categories?.map((c) => <a href={`/categories/${encodeURIComponent(c.toLowerCase())}/`} class="pill">{c}</a>)}
            </div>
          </div>
          </div>
        </div>
      ))}
    </div>
  </section>
  <script>
    import { formatPublicationDate } from '../lib/date';
    const input = document.getElementById('home-search');
    const container = document.getElementById('latest');
    const escapeAttribute = (value) => String(value).replace(/[&"<>]/g, (c) => ({ '&': '&amp;', '"': '&quot;', '<': '&lt;', '>': '&gt;' }[c]));
    const template = (r) => `
      <div class="card p-4">
        <div class="flex items-start gap-4">
        ${r.image ? `<a href="/recipes/${r.slug}" aria-hidden="true" tabindex="-1" class="shrink-0"><img src="${escapeAttribute(r.image)}" alt="" width="80" height="80" loading="lazy" decoding="async" class="h-20 w-20 rounded-lg object-cover" /></a>` : ''}
        <div class="grid min-w-0 flex-1 gap-2">
          <a href="/recipes/${r.slug}" class="font-semibold tracking-tight text-slate-900 hover:underline">${r.title}</a>
          <div class="publication-date">${formatPublicationDate(r.date)}</div>
          <div class="flex flex-wrap gap-1">${(r.categories||[]).map(c=>`<a href=\"/categories/${encodeURIComponent(c.toLowerCase())}/\" class=\"pill\">${c}</a>`).join('')}</div>
        </div>
        </div>
      </div>`
    let index;
    async function ensureIndex(){
      if (!index) {
        const res = await fetch('/search-index.json');
        index = await res.json();
      }
      return index;
    }
    async function renderLatestDefault() {
      const idx = await ensureIndex();
      container.innerHTML = idx.slice(0, 12).map(template).join('');
    }
    async function runSearch() {
      const q = input.value.trim().toLowerCase();
      const idx = await ensureIndex();
      if (!q) {
        return renderLatestDefault();
      }
      const results = idx.filter(r =>
        r.title.toLowerCase().includes(q)
        || (r.description||'').toLowerCase().includes(q)
        || (r.body||'').toLowerCase().includes(q)
        || (r.categories||[]).some(c => c.toLowerCase().includes(q))
      ).slice(0, 24);
      container.innerHTML = results.map(template).join('');
    }
    input.addEventListener('input', runSearch);
    // Initial render ensures we always show the latest ordering
    renderLatestDefault();
  </script>
</BaseLayout>
